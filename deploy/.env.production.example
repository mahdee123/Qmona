# Qmona production environment. Copy to <deploy-root>/.env.production on the server, fill EVERY value, chmod 600.
# This file is a template: never put real values here and never commit the real file.
# Generate secrets on the server:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
PORT=4000

# --- Database (MongoDB Atlas). Use a dedicated database user and the production database name. ---
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority

# --- Browser origins of the website (CORS + CSRF origin check) ---
CORS_ALLOWED_ORIGINS=https://qmona.com,https://www.qmona.com
# The website container, used by the API to ask the site to refresh its cache after content changes.
FRONTEND_URL=http://qmona-frontend:3000
REVALIDATE_SECRET=<random-secret-at-least-16-chars>
REVALIDATION_ENABLED=true

# --- Uploads (the host directory is mounted at /data/uploads by compose.yaml) ---
UPLOAD_DIR=/data/uploads
MEDIA_PUBLIC_BASE_URL=https://api.qmona.com
MEDIA_MAX_UPLOAD_MB=10

# --- Sessions and proxies ---
SESSION_TTL_HOURS=10
COOKIE_SECURE=true
# Hops that add an address to X-Forwarded-For between the visitor and the API:
# Cloudflare -> gateway nginx -> website container -> API  => 2
TRUST_PROXY=2

# --- Email (SMTP). The inquiry notification is sent from EMAIL_FROM to INQUIRY_NOTIFICATION_EMAILS. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<mailbox-address>
SMTP_PASSWORD=<app-password>
EMAIL_FROM=Qmona Website <mailbox-address>
INQUIRY_NOTIFICATION_EMAILS=<recipient-address>

# --- Rate limits ---
THROTTLE_ANON_PER_MIN=300
THROTTLE_LOGIN=10
THROTTLE_INQUIRY=10

LOG_LEVEL=info

# --- Used only by compose.yaml to build the website image (not secrets) ---
NEXT_PUBLIC_SITE_URL=https://qmona.com
MEDIA_ORIGINS=https://api.qmona.com
