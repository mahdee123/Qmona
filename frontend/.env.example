# ------------------------------------------------------------------------------
# Qmona frontend (Next.js) environment. Copy to .env.local for local development.
# ------------------------------------------------------------------------------

# Where the Next.js server reaches the backend API (server-side fetches + /api/v1 proxy).
# NOTE: this value is baked in at build time (next.config.ts rewrites) - rebuild after changing it.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Public site origin (canonical URLs, sitemap, Open Graph). Production: https://qmona.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origins allowed to serve uploaded images to next/image (comma-separated). Baked in at build time.
# Development: the local API. Production: the public API origin that serves /media.
MEDIA_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Shared secret the backend sends when asking Next.js to revalidate cached pages.
# Must match REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# Fallback cache lifetime (seconds) for public data if on-demand revalidation fails.
REVALIDATE_SECONDS=300
