# Backend environment for local development. Copy to backend/.env (git-ignored) and fill in the values.
# Production values: see deploy/.env.production.example. Never commit real secrets.

NODE_ENV=development
PORT=4000

# MongoDB Atlas. Use a separate database for development and for tests (the test database name must end in _test).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/qmona_dev?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/qmona_test?retryWrites=true&w=majority

# Browser origins of the Next.js site (CORS + CSRF origin check)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=dev-revalidate-secret-change-me
REVALIDATION_ENABLED=true

# Uploads (local disk) and the public base URL that serves /media
UPLOAD_DIR=./data/uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
MEDIA_MAX_UPLOAD_MB=10

SESSION_TTL_HOURS=10
COOKIE_SECURE=false
TRUST_PROXY=0

# Email. Leave SMTP_HOST empty to skip sending (inquiries are still saved; notification status becomes "skipped").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Qmona Website <no-reply@localhost>
INQUIRY_NOTIFICATION_EMAILS=

THROTTLE_ANON_PER_MIN=300
THROTTLE_LOGIN=10
THROTTLE_INQUIRY=10
LOG_LEVEL=info
